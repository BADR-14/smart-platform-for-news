APP_NAME="Smart Platform for News"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# لغة رسائل الـ API (التحقق والأخطاء)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_news
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# database: يحتاج تشغيل "php artisan queue:work" لمعالجة طلبات التوثيق
# sync    : تُعالج الطلبات فوراً دون worker (أسهل للتجربة المحلية)
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# الواجهات
# ---------------------------------------------------------------------------
# رابط لوحة الويب (يُستخدم في رابط إعادة تعيين كلمة المرور)
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
# الأصول المسموح لها باستدعاء الـ API من المتصفح (مفصولة بفاصلة)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# مدة صلاحية توكن الدخول بالدقائق (الافتراضي 30 يوماً)
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# ---------------------------------------------------------------------------
# حساب الأدمن الذي يُنشئه AdminSeeder (غيّر كلمة المرور قبل أي نشر حقيقي)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# البريد — log يكتب الرسائل (ومنها رموز OTP) في storage/logs/laravel.log
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@smart-news.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Stripe (شحن محفظة الشركة) — استخدم مفاتيح الاختبار sk_test / pk_test
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------
# تسجيل الدخول بـ Google من الموبايل: الـ Client IDs المسموح أن تصدر id_token (مفصولة بفاصلة)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=
# قراءة وثائق التوثيق (Vision API): مسار ملف مفتاح حساب الخدمة.
# إذا لم يوجد الملف تُحال كل طلبات التوثيق للأدمن يدوياً.
GOOGLE_APPLICATION_CREDENTIALS=
# إشعارات Push (Firebase): مسار ملف مفتاح حساب الخدمة. اتركه فارغاً لتعطيل الـ Push.
FCM_CREDENTIALS=
FCM_PROJECT_ID=

# Automatic verification via Google Vision. false = every request goes to the admin.
VERIFICATION_AUTO_ENABLED=true
